# Copy this file to .env and fill in what you have. .env is git-ignored: never commit it.
# You only need ONE provider. Training and the sample Roadster need no key at all.
# Note: a chat subscription (ChatGPT Plus, Claude Pro, Gemini Advanced) is NOT an API key -
# get keys from each provider's developer console (links below).

# Which AI writes your simulations:
#   anthropic | openai | gemini | groq | openrouter | deepseek | mistral | ollama | custom
# Leave empty to use the first provider below that has a real key.
TRAINLAB_LLM_PROVIDER=
# Optional: model id (leave empty for the provider's default; Studio > Settings > "Load models" lists yours)
TRAINLAB_LLM_MODEL=

ANTHROPIC_API_KEY=your-key-here      # https://console.anthropic.com
OPENAI_API_KEY=your-key-here         # https://platform.openai.com/api-keys
GEMINI_API_KEY=your-key-here         # https://aistudio.google.com/apikey   (free tier)
GROQ_API_KEY=your-key-here           # https://console.groq.com/keys        (free tier)
OPENROUTER_API_KEY=your-key-here     # https://openrouter.ai/keys           (some free models)
DEEPSEEK_API_KEY=your-key-here       # https://platform.deepseek.com/api_keys
MISTRAL_API_KEY=your-key-here        # https://console.mistral.ai/api-keys

# Ollama: free, runs on your own PC, no key. Install from https://ollama.com, then e.g.
#   ollama pull qwen2.5-coder:14b
OLLAMA_BASE_URL=http://localhost:11434/v1

# Any other OpenAI-compatible server (LM Studio, vLLM, Azure-style proxies, ...)
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=your-key-here

# Optional: raise if a provider cuts long answers off (0 = provider default)
TRAINLAB_LLM_MAX_TOKENS=0

# Optional: realistic visual meshes from a text-to-3D service (see trainlab/generator/mesh_provider.py)
TEXT_TO_3D_PROVIDER=none
TEXT_TO_3D_API_KEY=your-key-here
TEXT_TO_3D_ENDPOINT=
